# Local Terraform state and provider directories
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# User-specific variable files (keep terraform.tfvars.example and environments/*.tfvars.example committed)
*.tfvars
*.tfvars.json
!terraform.tfvars.example
!environments/*.tfvars.example

# Internal smoke-test and deprecated archive folders
smoke-test/
archive/

# Python caches & archives
__pycache__/
*.py[cod]
.pytest_cache/
*.zip

# Generated by scripts/backup_restore_connectors.py: these contain project, tenant, and
# instance identifiers and must not be committed.
*-backup.json
*-import.sh


